# Copy to .env.local (local dev) or set in Vercel → Project → Settings → Environment Variables.
# Server-only: never prefix these with NEXT_PUBLIC_, or they will be shipped to the browser.
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-id
# Optional but recommended: sent as the X-Webhook-Secret header; validate it with Header Auth on the n8n Webhook node.
N8N_WEBHOOK_SECRET=
